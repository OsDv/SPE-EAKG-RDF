@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://www.example.org/eakg#> .
@prefix archimate: <http://www.opengroup.org/xsd/archimate/3.0#> .
@base <http://www.example.org/eakg> .

#################################################################
# ONTOLOGY HEADER
#################################################################

<http://www.example.org/eakg> a owl:Ontology ;
    rdfs:label "EAKG Base Graph — Construction Pattern" ;
    rdfs:comment """Generic mechanism for Phase 1 (Knowledge Graph Creation / base graph)
of the Model-based EA Knowledge Graph construction process (Glaser, Ali,
Sallinger & Bork, 2022), applied per the ArchiMate Model Exchange File
Format (The Open Group, 2019, v3.1).

This file defines ONLY the reusable construction pattern behind Rules 1-3.
It does not enumerate any ArchiMate element or relationship types — that
closed vocabulary is supplied externally, at population time, from the
actual model being translated.""" .


#################################################################
# RULE 1 — ELEMENTS (VERTICES)
#
# No new vocabulary is minted here: elements are typed and described
# entirely with standard RDF/RDFS/OWL terms. The closed ArchiMate
# vocabulary (e.g. a class such as archimate:BusinessActor) supplies the
# rdf:type target once an actual model is loaded. Pattern, for one
# element instance:
#
#   <element-id> a owl:NamedIndividual, archimate:SomeLeafType ;
#       rdfs:label   "Element name"@en ;
#       rdfs:label   "Nom de l'élément"@fr ;
#       rdfs:comment "Element documentation"@en ;
#       rdfs:comment "Documentation de l'élément"@fr .
#
# - Identity  -> the ArchiMate identifier becomes the individual's IRI
# - Role      -> subject or object only, never a predicate
# - Name      -> rdfs:label with language tag (all <name> entries)
# - Doc       -> rdfs:comment with language tag (all <documentation> entries)
# - Base type -> rdf:type against the closed vocabulary (leaf types only)
#################################################################


#################################################################
# RULE 2 — RELATIONS (EDGES)
#
# Also no new vocabulary: a relation's own ArchiMate identifier is cast
# directly as an owl:ObjectProperty, avoiding reification/RDF-star. Its
# "core type" again comes from the closed ArchiMate vocabulary (e.g.
# archimate:Association). Pattern, for one relation instance:
#
#   <relation-id> a owl:ObjectProperty ;
#       rdfs:subPropertyOf archimate:CoreRelationshipType ;
#       rdfs:comment "Relation documentation"@en ;
#       rdfs:comment "Documentation de la relation"@fr .
#
#   <source-element-id> <relation-id> <target-element-id> .
#
# - Identity/structure -> ArchiMate identifier becomes the predicate IRI
# - Doc                 -> rdfs:comment on the predicate itself (all language variants)
# - Base typing         -> rdfs:subPropertyOf the closed relationship type
#################################################################


#################################################################
# RULE 3 — PROPERTY DEFINITIONS AND INSTANCES (DIRECT-PREDICATE PATTERN)
#
# Each property definition from the ArchiMate global property manager is
# declared as an owl:DatatypeProperty, uniquely identified by its name
# (key). A shared super-property archimate:Property enables generic
# queryability across all property predicates. No intermediate instance
# nodes are created — property values are expressed as direct triples.
#################################################################

archimate:Property a owl:DatatypeProperty ;
    rdfs:label "Property"@en ;
    rdfs:comment """Shared super-property for all ArchiMate property definitions.
Each concrete property predicate (e.g. ex:name, ex:age) is declared
rdfs:subPropertyOf archimate:Property, enabling generic querying
across all property values.""" .

#################################################################
# RULE 3 — DYNAMIC CONSTRUCTION PATTERN
#
# Pattern, for one property definition (declared once per unique key):
#
#   ex:PropertyName a owl:DatatypeProperty ;
#       rdfs:subPropertyOf archimate:Property ;
#       rdfs:range xsd:string .   # or xsd:integer / xsd:boolean / xsd:float
#
# Pattern, for one property instance — a direct triple linking
# the subject to the literal value:
#
#   <subject-id> ex:PropertyName "actual value"^^xsd:string .
#
# Because ArchiMate permits an element to carry duplicate values for the
# same property key, this is represented simply as multiple triples
# sharing the same subject and predicate, differentiated only by their
# object.
#
# - Identity (definition) -> property name/key becomes the predicate IRI
# - Type                  -> rdfs:range on the definition
# - Hierarchy             -> rdfs:subPropertyOf archimate:Property
# - Value                 -> direct triple with typed literal
#################################################################
